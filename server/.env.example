# Tortoise Server Environment Variables

# Application
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DEBUG=false
APP_PORT=8080

# Database
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/tortoise.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tortoise
DATABASE_PASSWORD=
DATABASE_SSLMODE=disable

# AI Providers
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com

GOOGLE_API_KEY=xxx

# Message Channels

## Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-xxx

## Discord
DISCORD_BOT_TOKEN=xxx

## Slack
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=xxx
SLACK_APP_TOKEN=xapp-xxx

## WhatsApp
WHATSAPP_SESSION_PATH=./data/whatsapp

## Matrix
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USERNAME=@tortoise:matrix.org
MATRIX_PASSWORD=xxx
MATRIX_DEVICE_ID=TortoiseBot

## Email
EMAIL_DISPLAY_NAME=Tortoise Bot
EMAIL_USERNAME=bot@example.com
EMAIL_PASSWORD=xxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_ENABLED=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENABLED=true

## Signal
SIGNAL_PHONE=+1234567890
SIGNAL_SESSION_PATH=./data/signal

# Plugins
PLUGINS_DIR=./plugins
PLUGINS_REGISTRY=https://plugins.tortoise.ai

# Matrix
MATRIX_ENABLED=false
MATRIX_ROOM_ID=

# Email
EMAIL_ENABLED=false
EMAIL_POLL_INTERVAL=60

# Enterprise
LDAP_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=

SAML_ENABLED=false
SAML_ENTITY_ID=
SAML_SSO_URL=
SAML_CERT_PATH=

OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=

# Cluster
CLUSTER_ENABLED=false
CLUSTER_NODE_ID=
CLUSTER_NAME=tortoise-cluster
CLUSTER_ADVERTISE_ADDR=
CLUSTER_JOIN_TOKEN=
