# EditorConfig for Tortoise

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,rs}]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{py,pyw}]
indent_style = space
indent_size = 4

[*.{dart}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
