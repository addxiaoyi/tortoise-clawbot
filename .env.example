# ============================================
# Tortoise AI 框架 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入你的配置

# ============================================
# 服务器配置
# ============================================

PORT=18792
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================
# AI 模型配置
# ============================================

# OpenAI API Key (https://platform.openai.com/api-keys)
# 优先级: 环境变量 > 配置文件
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# 默认 AI 模型 (gpt-4 | gpt-3.5-turbo | claude-3-sonnet-20240229 | llama2)
DEFAULT_MODEL=gpt-4

# AI 路由策略 (latency | load | cost)
AI_ROUTING=latency

# ============================================
# 消息渠道配置
# ============================================

# Telegram Bot Token (从 @BotFather 获取)
# 格式: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# 允许的 Telegram Chat ID (逗号分隔，留空则允许所有)
TELEGRAM_ALLOWED_CHATS=

# Discord Bot Token (从 Discord Developer Portal 获取)
# 格式: MTEwMTExMTExMTEx.exampl3.tOkEnHeRe
DISCORD_BOT_TOKEN=your-discord-bot-token
# Discord Guild ID (服务器 ID，可选)
DISCORD_GUILD_ID=

# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_WEBHOOK_URL=

# Microsoft Teams (可选)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# WhatsApp Business API (可选)
WHATSAPP_PHONE_NUMBER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ============================================
# 数据库配置
# ============================================

# 数据库类型: memory | sqlite | redis
DB_TYPE=memory

# SQLite 配置
SQLITE_PATH=./data/tortoise.db

# Redis 配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 安全配置
# ============================================

# JWT Secret (至少 32 个字符)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# API Key 认证 (true | false)
REQUIRE_API_KEY=false

# 限流配置 (每分钟请求数)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# CORS 配置 (逗号分隔的允许域名，* 表示全部)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*

# ============================================
# 设备发现配置
# ============================================

# 启用设备发现
DISCOVERY_ENABLED=true
DISCOVERY_PORT=18792
DISCOVERY_MDNS=true
DISCOVERY_UPNP=true
DISCOVERY_SSDP=false
ADVERTISE_INTERVAL=30

# ============================================
# 高级配置
# ============================================

# 最大会话数
MAX_SESSIONS=100000

# 会话超时 (秒)
SESSION_TIMEOUT=86400

# 消息缓冲区大小
MESSAGE_BUFFER_SIZE=10000

# Worker Pool 大小
WORKER_POOL_SIZE=100

# 内存池大小
MEMORY_POOL_SIZE=1024

# 启用指标收集 (Prometheus)
ENABLE_METRICS=true

# 启用链路追踪 (OpenTelemetry)
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================
# 前端配置
# ============================================

# 前端 API 地址
VITE_API_URL=http://localhost:18792

# ============================================
# 开发配置
# ============================================

# 开发模式
NODE_ENV=development

# 调试模式
DEBUG=false
