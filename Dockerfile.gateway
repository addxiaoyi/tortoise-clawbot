# Tortoise Gateway Dockerfile
FROM rust:1.75-slim-bookworm AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy source
COPY tortoise-core/ .

# Build release
RUN cargo build --release --bin tortoise-gateway

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary
COPY --from=builder /app/target/release/tortoise-gateway .

# Create non-root user
RUN useradd -m -u 1000 tortoise
USER tortoise

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run
ENTRYPOINT ["./tortoise-gateway"]
