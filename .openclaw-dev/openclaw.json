          { "id": "mixtral-8x7b-32768", "name": "Groq: Mixtral 8x7B", "contextWindow": 32768, "maxTokens": 32768 }
        ]
      },
      "perplexity": {
        "baseUrl": "${PERPLEXITY_BASE_URL}",
