            "maxTokens": 4096
          }
        ]
      },
      "custom-2": {
        "baseUrl": "${CUSTOM_2_BASE_URL}",
        "api": "openai-completions",
        "apiKey": "${CUSTOM_2_API_KEY}",
        "models": [
          {
            "id": "custom-model-2",
            "name": "Custom Model (Port 2)",
            "contextWindow": 4096
          }
        ]
      }
    },
    "bedrockDiscovery": {
      "enabled": false
    }
  }
}
