          { "id": "meta-llama/Llama-3-70b-chat-hf", "name": "Together: Llama 3 70B", "contextWindow": 8192, "maxTokens": 4096 }
        ]
      },
      "deepseek": {
        "baseUrl": "${DEEPSEEK_BASE_URL}",
        "api": "openai-completions",
        "apiKey": "${DEEPSEEK_API_KEY}",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek V3",
            "contextWindow": 32000,
            "maxTokens": 4096
