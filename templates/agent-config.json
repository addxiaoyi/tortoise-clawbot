{
  "name": "{{agentName}}",
  "version": "1.0.0",
  "description": "{{agentDescription}}",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@openclaw/sdk": "^0.15.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "@types/node": "^20.11.0"
  },
  "openclaw": {
    "permissions": [
      "{{permissions}}"
    ],
    "capabilities": {
      "memory": {{enableMemory}},
      "webSearch": {{enableWebSearch}}
    }
  }
}
