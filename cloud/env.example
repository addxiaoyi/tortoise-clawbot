# 全栈说明与环境索引：见仓库根 docs/full-stack-architecture.md
# 复制为 cloud/.env 后由 shell 导出，或在启动前设置到环境变量。
# docker compose -f cloud/docker-compose.yml up -d
# 然后:
#   SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
# 若 Core 启用了 API Key，再设置:
# SUPERTOKENS_API_KEY=

# 本 Go BFF 对外地址（须与 SuperTokens / 前端 apiDomain 一致）。
# 设为 auto 或未设置时，会在绑定监听后自动设为实际地址（见启动日志）。
CLOUD_API_DOMAIN=auto
# 浏览器里 Tortoise（Vite 默认端口见 tortoise/vite.config.ts，当前多为 1420）或其它 Web 前端 origin
CLOUD_WEBSITE_DOMAIN=http://127.0.0.1:1420

# 监听：auto = 在 127.0.0.1:8080–8199 中选第一个未被占用的端口；
# 亦可写固定值如 :8080、127.0.0.1:3000；0.0.0.0:auto = 在所有网卡上智能选端口。
# 若手动固定 CLOUD_API_DOMAIN 的端口，请把 CLOUD_HTTP_ADDR 设为同一端口，避免与 SuperTokens 不一致。
CLOUD_HTTP_ADDR=auto
CLOUD_API_BASE_PATH=/auth
CLOUD_WEBSITE_BASE_PATH=/auth
CLOUD_APP_NAME=Tohelp Cloud BFF

# 与自建 Postgres/Supabase 同库的连接串；不设则 /api/me 不写库，仅用 SuperTokens。
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/postgres?sslmode=disable
# 若 profiles 缺列，可在 DB 中执行 cloud/schema/profiles_bff_optional_columns.sql

# Postgres 连接池（仅当设置了 DATABASE_URL 时生效）
# CLOUD_DB_MAX_OPEN_CONNS=25
# CLOUD_DB_MAX_IDLE_CONNS=5
# CLOUD_DB_CONN_MAX_LIFETIME=30m

# 优雅关闭超时（收到 SIGINT/SIGTERM 时）
# CLOUD_SHUTDOWN_TIMEOUT=15s

# 默认两边并集：库 profiles 与 SuperTokens userroles（及权限推导）合并；仅 ST / 仅库用 supertokens | db
# CLOUD_PROFILE_ROLES_MODE=merge
# CLOUD_PROFILE_PERMISSIONS_MODE=merge
